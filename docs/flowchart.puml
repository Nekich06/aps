@startuml
skinparam activityShape rectangle
skinparam swimlaneBorderColor #333333
skinparam swimlaneTitleFontStyle bold
skinparam arrowColor #333333

title Flowchart: Бизнес-домен "Доставка котировок" (Вариант 21)

|Источник (ИБ, ИЗ1)|
start
:Инициализация генератора\nпуассоновского потока;
:Генерация интервала\nмежду запросами\n(PuassonLaw.getNextInterval());
:Создание QuoteUpdateRequest\n(вид инструмента, цена, timestamp);
:Передача запроса\nв Диспетчер;

|ДП (Диспетчер)|
:Приём запроса\nот Источника;
:Определить позицию в буфере\ncurrentIndex = (currentIndex + 1) mod capacity;

if (Буфер заполнен?) then (Да)
  |ДВ (Дисциплина отказа Д10О3)|
  :Удаление самого старого\nзапроса из буфера\n(RingBuffer.removeOldest());
  :Инкремент счётчика\nотказов в Statistics;
  |ДП (Диспетчер)|
  :Помещение нового запроса\nна освободившееся место\n(RingBuffer.pushRequest());
else (Нет)
  |ДП (Диспетчер)|
  :Помещение запроса\nв кольцевой буфер\n(RingBuffer.pushRequest());
endif

:Установка статуса\nrequest = WAITING;
:Сигнал Серверу\nо наличии запроса;

|Прибор (П31)|
:Сервер ищет свободный\nComputeNode;
if (Есть свободный узел?) then (Нет)
  :Ожидание\nосвобождения узла;
else (Да)
  |Прибор (П31)|
  :Выбор узла с максимальным\nприоритетом (Д2П1);
  :Запрос данных из буфера\nпо кольцевому принципу (Д2Б3)\n(Dispatcher.dequeue());
  |ДП (Диспетчер)|
  :Извлечение запроса\nиз RingBuffer\n(popRequest());
  :Установка статуса\nrequest = PROCESSING;
  |Прибор (П31)|
  :Генерация времени обработки\n(ExponentialLaw.getNextInterval());
  :Обработка запроса\n(proccessRequest);
  :Извлечение Info\n(id, actualPrice, timestamp);
  :Обновление котировки\nв Market.updatePrice();
  :Установка статуса\nrequest = DONE;
  :Освобождение ComputeNode;
endif

|Статистика (ОР2, ОД3)|
:Сбор метрик:
- время пребывания в очереди
- вероятность отказа
- интенсивность потока
- средний размер буфера;

if (Режим отображения?) then (ОР2 - автоматический)
  :Построение графиков\nосновных характеристик;
else (ОД3 - пошаговый)
  :Построение временной\nдиаграммы состояний:
  - занятость очереди
  - обрабатываемые данные;
endif

|Источник (ИБ, ИЗ1)|
if (Система работает?) then (Да)
  :Генерация следующего\nзапроса;
  |ДП (Диспетчер)|
  :Приём следующего запроса;
  note right: Цикл повторяется\n(бесконечный поток)
else (Нет)
  |Статистика (ОР2, ОД3)|
  :Финализация статистики;
  stop
endif

@enduml
